# IntelliAssist AI - Backend Environment Template
# Copy this file to .env and configure local values as needed.
# DO NOT commit real secrets or credentials to version control.

# Application Settings
ENVIRONMENT=development
DEBUG=true
PORT=8000

# Document Processing Settings
MAX_DOCUMENT_SIZE_MB=25
ALLOWED_EXTENSIONS=pdf,txt,docx

